{
  "name": "brain-mcp",
  "version": "1.1.0",
  "description": "Local MCP memory server — persistent SQLite knowledge base for AI coding assistants",
  "author": "Marcin Stanczyk",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "setup": "npm run build && node scripts/install-hooks.mjs",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:uninstall": "node scripts/install-hooks.mjs --uninstall",
    "hooks:status": "node scripts/install-hooks.mjs --dry-run",
    "postinstall": "node scripts/postinstall-notice.mjs",
    "test:hooks": "python3 -m unittest discover -s tests/hooks",
    "test:all": "npm test && npm run test:hooks",
    "eval": "tsx scripts/eval.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "12.11.1",
    "sqlite-vec": "0.1.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.15",
    "tsx": "4.23.0",
    "typescript": "5.9.3"
  }
}
